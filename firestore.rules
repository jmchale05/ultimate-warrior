rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    // Is the request from a signed-in user?
    function isAuthed() {
      return request.auth != null;
    }

    // Fetch the caller's user document (cached per request)
    function callerDoc() {
      let doc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return (doc != null) ? doc.data : {};
    }

    function callerRole() {
      return (callerDoc().role is string) ? callerDoc().role : null;
    }

    function callerSchool() {
      return (callerDoc().schoolId is string) ? callerDoc().schoolId : null;
    }

    function isAdmin() {
      return isAuthed() && callerRole() == 'admin';
    }

    function isTeacher() {
      return isAuthed() && callerRole() == 'teacher';
    }

    function isStudent() {
      return isAuthed() && callerRole() == 'student';
    }

    function sameSchool(schoolId) {
      return isAuthed() && callerSchool() != null && callerSchool() == schoolId;
    }

    function classSchoolId(classId) {
      return get(/databases/$(database)/documents/classes/$(classId)).data.schoolId;
    }

    function userSchoolId() {
      return resource.data.schoolId is string
        ? resource.data.schoolId
        : (
          resource.data.classId is string
            ? classSchoolId(resource.data.classId)
            : null
        );
    }

    function resultSchoolId() {
      return resource.data.schoolId is string
        ? resource.data.schoolId
        : (
          resource.data.classId is string
            ? classSchoolId(resource.data.classId)
            : null
        );
    }

    function requestedResultSchoolId() {
      return request.resource.data.schoolId is string
        ? request.resource.data.schoolId
        : (
          request.resource.data.classId is string
            ? classSchoolId(request.resource.data.classId)
            : null
        );
    }

    // ── /schools ─────────────────────────────────────────────────────────────
    // Admins: full access
    // Teachers/students: read only their own school document (no listing all schools)
    match /schools/{schoolId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() || (isTeacher() && sameSchool(schoolId));
      allow delete: if isAdmin();
    }

    match /schoolAccessCodes/{accessCode} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    match /adminAccessCodes/{accessCode} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    match /studentLoginUsernames/{username} {
      allow read, write: if false;
    }

    match /adminSignupTokens/{uid} {
      allow create: if isAuthed() &&
        request.auth.uid == uid &&
        request.resource.data.uid == uid &&
        request.resource.data.accessCode is string &&
        exists(/databases/$(database)/documents/adminAccessCodes/$(request.resource.data.accessCode));
      allow read: if isAuthed() && (request.auth.uid == uid || isAdmin());
      allow update: if false;
      allow delete: if isAuthed() && (request.auth.uid == uid || isAdmin());
    }

    // ── /users ────────────────────────────────────────────────────────────────
    // Users can read their own doc and edit their own profile, but never their
    // role, school, class or login fields.
    // Teachers can read docs for students in their school and manage those
    // students (but not change who is a student or which school they're in).
    // Admins have full access.
    // Listing: admins, and teachers looking up admins (deletion-request emails).
    // Students can't list users at all.

    // Fields only an admin (or the server) may change on someone's own record.
    // Students also can't change their own name; their teacher sets it.
    function keepsProtectedUserFields() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny([
        'uid', 'role', 'schoolId', 'classId', 'email', 'createdAt',
        'homeLoginEnabled', 'homeLoginUsername', 'homeLoginEnabledAt'
      ]) && !(resource.data.role == 'student' && changed.hasAny(['displayName']));
    }

    // What a teacher may not change on one of their students.
    function teacherKeepsStudentIdentity() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'uid', 'role', 'schoolId', 'email',
        'homeLoginEnabled', 'homeLoginUsername', 'homeLoginEnabledAt'
      ]);
    }

    match /users/{uid} {
      allow list: if isAdmin() || (isTeacher() && resource.data.role in ['admin', 'Admin']);
      allow read: if isAuthed() && (
        request.auth.uid == uid ||
        isAdmin() ||
        (isTeacher() && sameSchool(userSchoolId())) ||
        (isTeacher() && resource.data.role == 'admin')
      );
      // Allow initial self-profile creation on signup, plus teacher/admin managed creation.
      allow create: if isAuthed() && (
        (
          // A teacher signing up must hold a real access code for the school
          // they're joining; checked here, not just in the browser.
          request.auth.uid == uid &&
          request.resource.data.uid == uid &&
          request.resource.data.role == 'teacher' &&
          exists(/databases/$(database)/documents/schools/$(request.resource.data.schoolId)) &&
          request.resource.data.signupAccessCode is string &&
          exists(/databases/$(database)/documents/schoolAccessCodes/$(request.resource.data.signupAccessCode)) &&
          get(/databases/$(database)/documents/schoolAccessCodes/$(request.resource.data.signupAccessCode)).data.schoolId == request.resource.data.schoolId
        ) ||
        (
          request.auth.uid == uid &&
          request.resource.data.uid == uid &&
          request.resource.data.role == 'admin' &&
          exists(/databases/$(database)/documents/adminSignupTokens/$(uid))
        ) ||
        isAdmin() ||
        (
          isTeacher() &&
          request.resource.data.role == 'student' &&
          sameSchool(request.resource.data.schoolId)
        )
      );
      allow update: if isAuthed() && (
        (request.auth.uid == uid && keepsProtectedUserFields()) ||
        isAdmin() ||
        (
          isTeacher() &&
          resource.data.role == 'student' &&
          sameSchool(userSchoolId()) &&
          teacherKeepsStudentIdentity()
        )
      );
      allow delete: if isAdmin() || (
        isTeacher() &&
        resource.data.role == 'student' &&
        sameSchool(userSchoolId())
      );
    }

    // ── /classes ──────────────────────────────────────────────────────────────
    // Teachers can CRUD classes they own in their school.
    // Students can read their own class.
    // Admins have full access.
    match /classes/{classId} {
      allow read: if isAuthed() && (
        isAdmin() ||
        sameSchool(resource.data.schoolId)
      );
      allow create: if isAdmin() || (isTeacher() && sameSchool(request.resource.data.schoolId));
      allow update: if isAdmin() || (isTeacher() && sameSchool(resource.data.schoolId));
      allow delete: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    // ── /results ──────────────────────────────────────────────────────────────
    // Students can submit their own results.
    // Teachers can read results for their school.
    // Admins have full access.
    match /results/{resultId} {
      allow read: if isAuthed() && (
        isAdmin() ||
        (isTeacher() && sameSchool(resultSchoolId())) ||
        (isStudent() && resource.data.studentId == request.auth.uid)
      );
      allow create: if isAuthed() && (
        isAdmin() ||
        (isTeacher() && sameSchool(requestedResultSchoolId())) ||
        (
          isStudent() &&
          request.resource.data.studentId == request.auth.uid &&
          sameSchool(requestedResultSchoolId()) &&
          // One log is never more than a campaign needs (campaign 12 is 12 miles).
          request.resource.data.distanceMiles is number &&
          request.resource.data.distanceMiles > 0 &&
          request.resource.data.distanceMiles <= 12
        )
      );
      allow update: if isAdmin() || (isTeacher() && sameSchool(resultSchoolId()));
      allow delete: if isAdmin() || (isTeacher() && sameSchool(resultSchoolId()));
    }

    // ── /studentDeletionRequests ────────────────────────────────────────────
    // Teachers create requests for admin review.
    // Admins can view and manage all requests.
    match /studentDeletionRequests/{requestId} {
      allow create: if isTeacher() && sameSchool(request.resource.data.schoolId);
      allow read: if isAdmin() || (isTeacher() && sameSchool(resource.data.schoolId));
      allow update: if isAdmin();
      allow delete: if isAdmin() || (
        isTeacher() &&
        sameSchool(resource.data.schoolId) &&
        resource.data.status == 'pending'
      );
    }
  }
}
